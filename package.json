{
  "name": "proofroom-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "local:setup": "node scripts/local.mjs setup",
    "db:migrate": "node --env-file=.env --import tsx packages/db/migrate.ts",
    "dev": "node scripts/local.mjs start",
    "dev:web": "npm run dev -w @proofroom/web",
    "dev:api": "npm run dev -w @proofroom/api",
    "dev:worker": "npm run dev -w @proofroom/worker",
    "typecheck": "tsc --noEmit && npm run typecheck -w @proofroom/web",
    "build": "npm run build -w @proofroom/api && npm run build -w @proofroom/worker && npm run build -w @proofroom/web",
    "test:platform": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lint": "eslint apps packages scripts tests/platform tests/e2e",
    "backup": "node --env-file=.env --import tsx scripts/backup.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yazl": "3.3.1",
    "dotenv": "^17.2.0",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "s3rver": "3.7.1",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "4.1.12",
    "next": "16.4.6"
  },
  "overrides": {
    "vite": "7.3.8",
    "source-map-js": "1.2.2",
    "brace-expansion@^1.0.0": "1.1.22",
    "brace-expansion@^5.0.0": "5.0.13",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
